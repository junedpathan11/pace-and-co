# Pace & Co. — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Web3Forms access key (https://web3forms.com), used by the contact form and
# the checkout order notification. Leave as the placeholder to see the
# "not configured" guard states — the site still works without it.
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here
